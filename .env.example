SUBREGATOR_IMAGE=ghcr.io/subregator/subregator-backend:edge
SUBREGATOR_FRONTEND_IMAGE=ghcr.io/subregator/subregator-frontend:edge
SUBREGATOR_FRONTEND_BIND=127.0.0.1
SUBREGATOR_FRONTEND_PORT=8081
SUBREGATOR_BIND=127.0.0.1
SUBREGATOR_PORT=8080
SUBREGATOR_NETWORK=true
SUBREGATOR_CORS_ORIGIN=
SUBREGATOR_LOG_FORMAT=json
SUBREGATOR_LOG_LEVEL=info
SUBREGATOR_CHECKS_RPM=120
# Off until source quotas and public display/retention rights are confirmed.
SUBREGATOR_IRR=false
# Requires an approved AbuseIPDB account, quota, public display and retention terms.
SUBREGATOR_ABUSEIPDB=false
SUBREGATOR_ABUSEIPDB_KEY=
# Optional token for the free /lite endpoint only.
SUBREGATOR_IPINFO_LITE_TOKEN=
SUBREGATOR_REQUESTS_RPS=100
SUBREGATOR_MAX_CONCURRENT=32
# Replace with a random URL-safe password before starting Compose.
POSTGRES_USER=subregator
POSTGRES_DB=subregator
POSTGRES_PASSWORD=change-me-before-deploying
# Optional external PostgreSQL URL; keep credentials only in the untracked .env.
SUBREGATOR_DATABASE_URL=

# Licensed Spamhaus DNS Blocklists via HTTPS; separate product/key from DQS DNS or SIA.
# Requires quota and public display/retention approval; one IP sample is not subnet coverage.
SUBREGATOR_SPAMHAUS=false
SUBREGATOR_SPAMHAUS_KEY=
